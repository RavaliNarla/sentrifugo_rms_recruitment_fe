# Office Mac / LAN Docker — copy to `.env` (or Docker env).
# BEs stay on 8080 / 8085 / 8086; only FE listen port changes (e.g. 5300).
REACT_APP_RECRUITER_API_URL=http://172.16.2.111:8086/recruiter-portal/api/v1/recruiter
REACT_APP_MASTER_API_URL=http://172.16.2.111:8080/master-portal/api/v1/master
REACT_APP_AUTH_API_URL=http://172.16.2.111:8085/auth-portal/api/v1/auth

HTTPS=false
PORT=5300

# Matching recruiter-portal env (optional, for email/UI links):
# UI_BASE_URL=http://172.16.2.111:5300
# APP_BASE_URL=http://172.16.2.111:8086/recruiter-portal
